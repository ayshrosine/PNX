# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=pnx_development_jwt_secret_key_minimum_32_characters_long_for_security

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
# You can paste your Supabase DB connection string directly below:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pnx_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pnx_db?schema=public"
SYSTEM_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pnx_db?schema=public"

# Supabase Auth & Storage API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Internal Cron / Job Runner Secret
CRON_SECRET="pnx_cron_secret_token_12345"

# Third-party Integrations (Optional / V1)
RESEND_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
