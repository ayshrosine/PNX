# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=pnx_development_jwt_secret_key_minimum_32_characters_long_for_security

# Database Configuration (Supabase PostgreSQL / Local PostgreSQL)
# When you have your Supabase credentials, paste your connection string here.
DATABASE_URL="postgresql://postgres:yourpassword@db.yourref.supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:yourpassword@db.yourref.supabase.co:5432/postgres?schema=public"
SYSTEM_DATABASE_URL="postgresql://postgres:yourpassword@db.yourref.supabase.co:5432/postgres?schema=public"

# Supabase Auth & Storage API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Internal Cron / Job Runner Secret
CRON_SECRET="pnx_cron_secret_token_12345"

# Third-party Integrations (Optional / V1)
# Resend or AWS SES for sending transaction emails
RESEND_API_KEY="re_sample_api_key_placeholder"

# Razorpay for online client payments & platform billing
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
